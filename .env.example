# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ROLE_KEY=  # service_role key

# Postgres
# DATABASE_URL uses PgBouncer (pooled, port 6543) for runtime queries
# DIRECT_URL uses a direct connection (port 5432) required for migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grabber
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/grabber

# Payload CMS
PAYLOAD_SECRET=  # any long random string

# S3 Storage
# Local dev: uses MinIO defaults (docker compose up)
# Production: Supabase dashboard → Settings → Storage → S3 Access Keys
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=products
S3_ENDPOINT=  # local: http://localhost:9000 | prod: https://<ref>.supabase.co/storage/v1/s3
S3_REGION=    # local: us-east-1 | prod: auto
